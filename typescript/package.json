{
  "name": "@lawdiver/api-examples",
  "version": "1.0.0",
  "description": "TypeScript client and examples for the LawDiver caselaw API (https://lawdiver.com/docs/api)",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "example:search": "tsx examples/01-search.ts",
    "example:cite-check": "tsx examples/02-cite-check.ts",
    "example:retrieve": "tsx examples/03-retrieve.ts",
    "example:document": "tsx examples/04-document-cite-check.ts",
    "example:agent": "tsx examples/05-agent-search.ts",
    "example:usage": "tsx examples/06-usage.ts",
    "example:good-law": "tsx examples/07-good-law-cited-by.ts",
    "examples": "npm run example:search && npm run example:cite-check && npm run example:retrieve && npm run example:usage"
  },
  "engines": {
    "node": ">=18"
  },
  "keywords": [
    "lawdiver",
    "caselaw",
    "legal-api",
    "citation-checker",
    "typescript"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.10",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
